{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/vue",
    "ultracite/biome/astro",
    "ultracite/biome/playwright"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      },
      "style": {
        "noNamespace": "off",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useErrorCause": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["camelCase", "kebab-case", "PascalCase"]
          }
        }
      },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        "noEmptySource": {
          "level": "error",
          "options": {
            "allowComments": true
          }
        },
        "useAwait": "off",
        "useExpect": "off"
      }
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro", "**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": {
              "level": "error",
              "options": {
                "ignore": ["class", "set:html"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["demos/mobile/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "on",
              "options": {
                "skip": ["SvgText"]
              }
            },
            "useReactNativePlatformComponents": "error"
          },
          "style": {
            "noReactNativeLiteralColors": "error"
          },
          "suspicious": {
            "noReactNativeDeepImports": "error"
          }
        }
      }
    },
    {
      "includes": ["demos/extension/public/**"],
      "javascript": {
        "globals": ["chrome"]
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "useConsistentTypeDefinitions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/tests/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
