# Install the `file:..` library as a real copy instead of a symlink. Metro does
# not apply a package's `exports` map through a symlink, and it will not read a
# gitignored directory such as ../dist, so a copied install is what lets the app
# import the library by name. The copy carries whatever ../dist held when it was
# packed, and installing does not run the library's prepack, so `npm run build`
# at the root has to come first. Packing an absent dist/ is not an error, so
# skipping it fails later as an unresolved import rather than at install time.
install-links=true
