{
  "manifest_version": 3,
  "name": "mera paper trading demo",
  "version": "0.1.0",
  "description": "A local side-panel demo for mera passkey accounts and fictional trades.",
  "minimum_chrome_version": "122",
  "key": "",
  "permissions": ["sidePanel"],
  "host_permissions": ["https://mera.category.xyz/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open mera trading demo",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html?panel=1"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://evm-network-production.up.railway.app; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
