---
// Renders the demo app in an iframe. The demo reports its content height so
// stacked layouts can show it without an inner scrollbar; wide layouts may
// still constrain it to the viewport.
//
// Safari has not implemented passkey creation in cross-origin frames, so the
// frame has to stay same-origin: the demo is built into this site at /demo/.
const DEMO_PATH = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/demo/`;
---

<iframe src={DEMO_PATH} data-demo title="mera demo" class="not-content"></iframe>
<a class="open-demo" href={DEMO_PATH} target="_blank" rel="noreferrer">
  If the demo does not work, try opening it in a new tab.
</a>

<script>
  window.addEventListener("message", (event) => {
    const data = event.data;
    if (
      data?.type !== "mera:resize" ||
      event.origin !== location.origin ||
      !Number.isFinite(data.height) ||
      data.height <= 0
    ) {
      return;
    }

    for (const frame of document.querySelectorAll<HTMLIFrameElement>(
      "iframe[data-demo]",
    )) {
      if (frame.contentWindow === event.source) {
        frame.style.setProperty(
          "--demo-content-height",
          `${Math.ceil(data.height)}px`,
        );
      }
    }
  });
</script>

<style>
  iframe {
    display: block;
    width: 100%;
    border: none;
  }

  .open-demo {
    display: block;
    padding: 0.625rem 0.875rem;
    border-top: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
  }

  .open-demo:hover {
    text-decoration: underline;
  }
</style>
