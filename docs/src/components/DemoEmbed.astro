---
// Renders the demo app in an iframe. The demo reports its content height so
// stacked layouts can show it without an inner scrollbar; wide layouts may
// still constrain it to the viewport.
//
// The frame stays same-origin because WebKit refuses passkey creation in a
// cross-origin frame, so the demo is built into this site at /demo/. Passkey
// ceremonies and clipboard writes need no delegated permissions there: their
// default allowlist is `self`. The path names index.html because the dev server
// serves files from public/ but does not resolve directory indexes.
const DEMO_PATH = "/demo/index.html";
---

{/* biome-ignore lint/security/useIframeSandbox: the demo needs scripts and its own origin for passkeys, and a sandbox that allows both lets a same-origin frame remove it. */}
<iframe
  class="not-content"
  data-demo
  src={DEMO_PATH}
  title="mera demo"
></iframe>
<a class="open-demo" href={DEMO_PATH} rel="noreferrer" target="_blank">
  If the demo does not work, try opening it in a new tab.
</a>

<script>
  window.addEventListener("message", (event) => {
    const { data } = event;
    if (
      data?.type !== "mera:resize" ||
      event.origin !== location.origin ||
      !Number.isFinite(data.height) ||
      data.height <= 0
    ) {
      return;
    }

    for (const frame of document.querySelectorAll<HTMLIFrameElement>(
      "iframe[data-demo]"
    )) {
      if (frame.contentWindow === event.source) {
        frame.style.setProperty(
          "--demo-content-height",
          `${Math.ceil(data.height)}px`
        );
      }
    }
  });
</script>

<style>
  iframe {
    display: block;
    width: 100%;
    border: none;
  }

  .open-demo {
    display: block;
    padding: 0.625rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--sl-color-text-accent);
    text-align: center;
    text-decoration: none;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .open-demo:hover {
    text-decoration: underline;
  }
</style>
