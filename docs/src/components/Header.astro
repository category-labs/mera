---
import LanguageSelect from "virtual:starlight/components/LanguageSelect";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import config from "virtual:starlight/user-config";
import { withBasePath } from "../base-path";
import CategoryLogotype from "./CategoryLogotype.astro";

// Match Starlight's default search behavior so an explicit Search override
// can still opt in when Pagefind is disabled.
const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <a class="brand-link" href="https://category.xyz" aria-label="Category Labs">
      <CategoryLogotype />
    </a>
    <span class="brand-divider" aria-hidden="true"></span>
    <SiteTitle />
  </div>

  <div class="search-wrapper sl-flex print:hidden">
    {shouldRenderSearch && <Search />}
  </div>

  <div class="right-group sl-flex print:hidden">
    <div class="social-icons sl-flex">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
    <a class="header-cta" href={withBasePath("/getting-started/")}>
      <span class="mobile-label">Get started</span>
      <span class="desktop-label">Getting started&nbsp;→</span>
    </a>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: grid;
      grid-template-columns: minmax(min-content, 1fr) auto auto;
      gap: 0.5rem;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      min-width: 0;
      margin: -0.25rem;
      padding: 0.25rem;
      overflow: clip;
      align-items: center;
      gap: 0.5rem;
    }

    .brand-link {
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
      color: var(--sl-color-white);
      transition: opacity 0.15s;
    }

    .brand-link:hover {
      opacity: 0.7;
    }

    /* The wordmark's viewBox includes descenders (g, y), so centering the
       boxes leaves its baseline above the site title's. Nudge it down so
       both sit on one baseline; the offset shrinks as the svg grows. */
    .brand-link :global(svg) {
      height: 0.875rem;
      width: auto;
      display: block;
      transform: translateY(0.21875rem);
    }

    .brand-divider {
      width: 1px;
      height: 1.125rem;
      flex-shrink: 0;
      background: var(--sl-color-gray-5);
    }

    .search-wrapper,
    .right-group,
    .social-icons {
      align-items: center;
    }

    .right-group {
      gap: 0.5rem;
    }

    .social-icons {
      gap: 0.5rem;
    }

    .header-cta {
      display: inline-flex;
      min-height: 2.25rem;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      padding: 0.45rem 0.55rem;
      background: var(--sl-color-accent);
      color: #ffffff;
      font-size: 0.78rem;
      font-weight: 500;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s;
    }

    .header-cta:hover {
      background: color-mix(in srgb, var(--sl-color-accent) 88%, #000);
    }

    .desktop-label {
      display: none;
    }

    @media (min-width: 50rem) {
      .title-wrapper {
        gap: 0.75rem;
      }

      .brand-link :global(svg) {
        height: 1rem;
        transform: translateY(0.25rem);
      }

      .brand-divider {
        height: 1.25rem;
      }

      .header {
        grid-template-columns:
          minmax(min-content, 1fr)
          minmax(12rem, 32rem)
          minmax(min-content, 1fr);
        gap: var(--sl-nav-gap);
      }

      .search-wrapper {
        width: 100%;
      }

      .right-group {
        justify-self: end;
        gap: 1rem;
      }

      .header-cta {
        min-height: 2.5rem;
        padding: 0.65rem 1rem;
        font-size: 0.9rem;
      }

      .mobile-label {
        display: none;
      }

      .desktop-label {
        display: inline;
      }
    }
  }
</style>
