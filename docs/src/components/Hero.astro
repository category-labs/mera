---
// Hero override (registered in astro.config.mjs): the standard Starlight hero
// copy on the left, the live demo on the right. Frontmatter still drives the
// title, tagline, and actions.
import { LinkButton } from "@astrojs/starlight/components";
import DemoEmbed from "./DemoEmbed.astro";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({
              attrs: { class: className, ...attrs } = {},
              icon,
              link: href,
              text,
              variant,
            }) => (
              <LinkButton
                {href}
                {variant}
                icon={icon?.name}
                class:list={[className]}
                {...attrs}
              >
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            ),
          )}
        </div>
      )
    }
  </div>
  <div class="demo not-content">
    <p class="demo-label">Demo</p>
    <DemoEmbed />
  </div>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: 100%;
    gap: 2rem;
    align-items: center;
    padding-bottom: 1rem;
  }

  .stack {
    flex-direction: column;
    gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
    text-align: center;
  }

  .copy {
    flex-direction: column;
    gap: 1rem;
    align-items: center;
  }

  .copy > * {
    max-width: 50ch;
  }

  h1 {
    font-size: clamp(2.4rem, 4.5vw + 1rem, 3.2rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .tagline {
    font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
    color: var(--sl-color-gray-2);
  }

  .actions {
    gap: 1rem 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .demo-label {
    font-family: var(--sl-font-headings);
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.5rem;
  }

  /* The demo needs ~350px; bleed it to the viewport edges on phones,
     like the article does. */
  @media (max-width: 30rem) {
    .demo {
      margin-inline: calc(-1 * var(--sl-content-pad-x));
    }

    .demo-label {
      padding-inline: var(--sl-content-pad-x);
    }

    .demo :global(iframe) {
      border-inline: none;
      border-radius: 0;
    }
  }

  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 6fr 5fr;
      gap: clamp(1.5rem, 4vw, 3.5rem);
      padding-block: clamp(2.5rem, calc(1rem + 6vmin), 5rem);
    }

    .demo {
      /* Reserve the demo's signed-in height (~869px measured) so its growth
         lands in space the hero already owns and the page never reflows.
         Retune if the demo's signed-in layout grows taller. */
      --mera-demo-reserve: 900px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: var(--mera-demo-reserve);
    }

    .stack {
      text-align: start;
    }

    .copy {
      align-items: flex-start;
    }

    .actions {
      justify-content: flex-start;
    }
  }
</style>
