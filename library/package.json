{
  "name": "@category-labs/mera",
  "version": "0.4.0",
  "description": "Accounts on any chain and platform, from a passkey",
  "keywords": [
    "passkey",
    "webauthn",
    "prf",
    "secp256k1",
    "ed25519",
    "ethereum",
    "evm",
    "solana",
    "signing",
    "crypto"
  ],
  "homepage": "https://mera.category.xyz",
  "bugs": {
    "url": "https://github.com/category-labs/mera/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/category-labs/mera.git",
    "directory": "library"
  },
  "license": "(MIT OR Apache-2.0)",
  "author": "Category Labs",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viem": {
      "types": "./dist/viem.d.ts",
      "default": "./dist/viem.js"
    },
    "./react-native-webauthn-client": {
      "types": "./dist/react-native-webauthn-client.d.ts",
      "default": "./dist/react-native-webauthn-client.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi.d.ts",
      "default": "./dist/wagmi.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsc",
    "check:pack": "npm run build && tsc -p tsconfig.public-types.json && node scripts/verify-tarball.mjs && publint --strict",
    "prepack": "npm run build",
    "test": "npm run build && tsc -p tsconfig.test.json && playwright test",
    "test:e2e": "npm test -- --project chromium-e2e"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@wagmi/core": "3.6.9",
    "publint": "0.3.25",
    "react-native-passkey": "3.6.2",
    "typescript": "7.0.2",
    "viem": "2.58.1"
  },
  "peerDependencies": {
    "@wagmi/core": "^3.0.0",
    "react-native-passkey": "3.6.2",
    "viem": "^2.28.0"
  },
  "peerDependenciesMeta": {
    "@wagmi/core": {
      "optional": true
    },
    "react-native-passkey": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
