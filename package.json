{
  "name": "@category-labs/mera",
  "version": "0.1.0",
  "description": "Primitive-first passkey-backed signing utilities for secp256k1 (EVM) and Ed25519 (Solana).",
  "keywords": [
    "passkey",
    "webauthn",
    "prf",
    "secp256k1",
    "ed25519",
    "ethereum",
    "evm",
    "solana",
    "signing",
    "crypto"
  ],
  "homepage": "https://mera.category.xyz",
  "bugs": {
    "url": "https://github.com/category-labs/mera/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/category-labs/mera.git"
  },
  "license": "(MIT OR Apache-2.0)",
  "author": "Category Labs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./viem": {
      "types": "./dist/viem.d.ts",
      "import": "./dist/viem.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "private": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "biome check .",
    "check:pack": "npm run build && node scripts/verify-tarball.mjs && publint --strict",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "npm run build && tsc -p tsconfig.test.json && playwright test",
    "test:e2e": "npm test -- --project chromium-e2e"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0"
  },
  "peerDependencies": {
    "viem": "^2.28.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.3",
    "publint": "^0.3.21",
    "typescript": "^7.0.2",
    "viem": "^2.55.2"
  },
  "engines": {
    "node": ">=24"
  }
}
